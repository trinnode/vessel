# ===========================================================================
# VESSEL environment template
# ===========================================================================
# Copy this file to .env and fill in values. Everything with a default value
# below is PUBLIC and needs no account. Items marked SECRET require action;
# follow the comment for how to obtain each one. NEVER commit .env to git.
#
# cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# NEAR network (public, no account needed)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Fallback RPCs tried in order when the primary fails.
NEAR_RPC_FALLBACK_URLS=https://rpc.fastnear.com,https://free.rpc.fastnear.com

# ---------------------------------------------------------------------------
# Contract account ids (NEAR named accounts, all public)
# ---------------------------------------------------------------------------
# The NFT factory (NEP-171) that mints vessels and their sub-accounts.
NEXT_PUBLIC_VESSEL_NFT_ID=vessel.trinnode.near
VESSEL_NFT_ID=vessel.trinnode.near
# The marketplace with anti-drain escrow.
NEXT_PUBLIC_VESSEL_MARKET_ID=market.vessel.trinnode.near
VESSEL_MARKET_ID=market.vessel.trinnode.near
# Template name for per-vessel sub-accounts: vessel-000042.vessel.trinnode.near
NEXT_PUBLIC_VESSEL_SUBACCOUNT_FORMAT=vessel-%06d.vessel.trinnode.near

# NEAR Intents (the Verifier contract at intents.near). Public mainnet account.
NEXT_PUBLIC_INTENTS_CONTRACT_ID=intents.near
INTENTS_CONTRACT_ID=intents.near

# ---------------------------------------------------------------------------
# Public data APIs (keyless)
# ---------------------------------------------------------------------------
# Token metadata for cross-chain asset ids is read from the Verifier itself
# (mt_token_metadata view calls) and valued with CoinGecko free tier.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# SECRET (optional): CoinGecko demo key for higher rate limits.
# HOW TO GET IT: free account at https://www.coingecko.com/en/api then copy
# the demo key from the dashboard.
# COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxx
COINGECKO_API_KEY=

# 1Click / Intents public endpoints used for deposit address generation and
# swap quotes. These are the documented public endpoints of the NEAR Intents
# front end; swap them if you self-host a solver endpoint.
NEXT_PUBLIC_INTENTS_API_BASE=https://bridge.intents.near/api
NEXT_PUBLIC_SOLVER_API_BASE=https://solver.dl.near.dev

# ---------------------------------------------------------------------------
# SECRET: NEAR mainnet deployer account for the three contracts.
#
# HOW TO GET IT (choose one, both free):
#   1. Web wallet: create an account at https://app.mynearwallet.com
#      (for example trinnode.near), fund it with about 8 NEAR (storage for the
#      factory plus three contract deployments), then run:
#        near account import-account using-web-wallet mynearwallet \
#          trinnode.near network-config mainnet
#   2. Ledger hardware wallet: near account import-account using-ledger ...
#
# Deployment reads keys from ~/.near-credentials (never from this file).
DEPLOYER_ACCOUNT_ID=trinnode.near

# Optional receiver of marketplace fees; defaults to the deployer.
FEE_RECIPIENT_ACCOUNT_ID=trinnode.near

# ---------------------------------------------------------------------------
# Frontend build flags
# ---------------------------------------------------------------------------
# 1 = serve demo data without RPC (for offline judging of the UI only).
NEXT_PUBLIC_DEMO_MODE=0
